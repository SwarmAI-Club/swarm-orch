{
  "$schema": "SwarmAI Mesh Protocol v0.2",
  "description": "7 種 JSON message，Node router <-> Python worker 互通。Transport Phase 1 = HTTP over Tailscale (100.x)，協議層抽象可換 libp2p/MQ。v0.2 加 node_status (heartbeat) + credit 事件。",
  "messages": {
    "node_register": {
      "from": "worker",
      "to": "router",
      "purpose": "Worker 上線時註冊自身能力",
      "fields": {
        "type": { "const": "node_register" },
        "node_id": "string (unique)",
        "capabilities": "string[] (Jaccard matching 用)",
        "model": "string (e.g. Qwopus-27B)",
        "gpu": "string (e.g. 2080Ti 22GB)",
        "max_context": "number (tokens)",
        "speed": "string (optional, t/s)"
      }
    },
    "beacon": {
      "from": "router",
      "to": "worker",
      "purpose": "Router 廣播任務，等 worker 回覆是否有 capability 接",
      "fields": {
        "type": { "const": "beacon" },
        "beacon_id": "string (uuid)",
        "task": "string (描述)",
        "required_capabilities": "string[]",
        "priority": "number (0-1)",
        "deadline": "ISO timestamp (optional)"
      }
    },
    "beacon_response": {
      "from": "worker",
      "to": "router",
      "purpose": "Worker 回覆：有無能力 + 信心分",
      "fields": {
        "type": { "const": "beacon_response" },
        "beacon_id": "string (match beacon)",
        "node_id": "string (match node_register)",
        "accepted": "boolean",
        "confidence": "number (0-1, voting 權重用)",
        "reason": "string (optional)"
      }
    },
    "task_assign": {
      "from": "router",
      "to": "worker",
      "purpose": "Router 確認派工",
      "fields": {
        "type": { "const": "task_assign" },
        "task_id": "string (uuid)",
        "beacon_id": "string (match beacon)",
        "node_id": "string (assign to)",
        "prompt": "string",
        "n_votes": "number (default 3, CoT voting 次數)",
        "temperature": "number (default 0.6)"
      }
    },
    "task_result": {
      "from": "worker",
      "to": "router",
      "purpose": "Worker 回傳結果（可多個 vote）",
      "fields": {
        "type": { "const": "task_result" },
        "task_id": "string (match task_assign)",
        "node_id": "string",
        "votes": "array of {content, confidence, reasoning}",
        "duration_ms": "number"
      }
    },
    "node_status": {
      "from": "worker",
      "to": "router",
      "purpose": "Heartbeat — worker 定期佈告自己狀態（睡眠共享 / 用戶使用中），供 Trust/credit 計分",
      "fields": {
        "type": { "const": "node_status" },
        "node_id": "string (match node_register)",
        "status": "enum [IDLE_SHARING, USER_OCCUPIED]",
        "vram_used_gb": "number (optional)",
        "model_loaded": "string (optional)",
        "load": "number (0-1, optional)",
        "sleeping": "boolean (optional, 是否響睡眠共享窗口內)",
        "ts": "number (unix)"
      }
    },
    "credit_mint": {
      "from": "router",
      "to": "worker",
      "purpose": "任務完成後 router 通知 worker 入帳（Time-Bank）",
      "fields": {
        "type": { "const": "credit_mint" },
        "node_id": "string",
        "task_id": "string",
        "gpu_min": "number",
        "credit": "number"
      }
    },
    "credit_burn": {
      "from": "worker",
      "to": "router",
      "purpose": "Requester 消耗 credit 提交任務",
      "fields": {
        "type": { "const": "credit_burn" },
        "node_id": "string",
        "task_id": "string",
        "credit": "number"
      }
    }
  }
}